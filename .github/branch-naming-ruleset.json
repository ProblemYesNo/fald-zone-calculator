{
  "name": "Branch names: feature, bugfix, or docs prefixes",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/feat/**/*",
        "refs/heads/feature/**/*",
        "refs/heads/bugfix/**/*",
        "refs/heads/docs/**/*"
      ]
    }
  },
  "rules": [
    { "type": "creation" }
  ]
}
